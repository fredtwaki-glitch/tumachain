# Copy this file to .env and fill in local/dev values.
# NEVER commit a real .env file or real secrets.

# --- App ---
APP_NAME=Pay-via-Mail
APP_ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./pay_via_mail.db

# --- Development admin bootstrap ---
# Local sandbox convenience only. Keep APP_ENV=development.
DEV_AUTO_CREATE_ADMIN=true
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=walenisi1
DEV_ADMIN_FULL_NAME=TumaChain Admin

# --- JWT / Security ---
# Generate your own dev secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-dev-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (mock/dev provider) ---
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=noreply@payviamail.dev

# --- Blockchain (mock adapters only in Phase 1/2) ---
BLOCKCHAIN_MODE=arc_testnet

# --- Future production integration placeholders (DO NOT FILL WITH REAL VALUES IN DEV) ---
BTC_RPC_URL=
ETH_RPC_URL=
SOL_RPC_URL=
EVM_TESTNET_RPC_URL=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
KYC_PROVIDER_API_KEY=
SANCTIONS_SCREENING_API_KEY=
SMS_PROVIDER_API_KEY=

# --- Phase 3: compliance / limits (dev defaults — configure per your
# actual jurisdiction and provider before any real deployment) ---
COMPLIANCE_PROVIDER=mock
UNVERIFIED_DAILY_LIMIT_USD=100.0
EMAIL_VERIFIED_DAILY_LIMIT_USD=10000.0
KYC_VERIFIED_DAILY_LIMIT_USD=50000.0
LARGE_TRANSACTION_FLAG_USD=5000.0
VELOCITY_MAX_TX_PER_HOUR=10
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Arc Testnet (development)
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io

ENVIRONMENT=testnet
BLOCKCHAIN_MODE=arc_testnet
DATABASE_URL=sqlite:///./pay_via_mail.db
JWT_SECRET_KEY=replace-me
CORS_ORIGINS=["https://tumachain.onrender.com"]
USDC_CONTRACT_ADDRESS=
USDT_CONTRACT_ADDRESS=
KYC_PROVIDER=mock
KYC_API_KEY=
SETTLEMENT_PROVIDER=testnet_mock
SETTLEMENT_API_KEY=
WEBHOOK_SECRET=
